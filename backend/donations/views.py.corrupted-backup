    let mounted = true;

    async function loadDonations() {
      try {
        setLoading(true);

        const response = await fetch('/api/donations/');

        if (!response.ok) {
          throw new Error(
            `Donation API failed: ${response.status}`
          );
        }

        const data = await response.json();

        /*
         * Supports both:
         *
         * [...]
         *
         * and
         *
         * { results: [...] }
         */

        const donations = Array.isArray(data)
          ? data
          : Array.isArray(data.results)
          ? data.results
          : [];

        if (mounted) {
          const normalized = donations
            .map(normalizeDonation)
            .filter(
              (item) =>
                item.availability === 'Available'
            );

          setApiItems(normalized);
        }
      } catch (error) {
        console.error(
          'Failed to load landing page donations:',
          error
        );

        if (mounted) {
          setApiItems([]);
        }
      } finally {
        if (mounted) {
          setLoading(false);
        }
