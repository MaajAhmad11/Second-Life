// ============================================================
// CONDITION COLORS
// ============================================================

function getConditionColor(condition) {
  switch (String(condition || '').toUpperCase()) {
    case 'LIKE_NEW':
    case 'LIKE NEW':
      return 'bg-emerald-50 text-[#15803D] border-emerald-200';

    case 'EXCELLENT':
      return 'bg-blue-50 text-blue-700 border-blue-200';

    case 'GOOD':
      return 'bg-amber-50 text-amber-800 border-amber-200';

    case 'GENTLY_USED':
    case 'GENTLY USED':
      return 'bg-teal-50 text-teal-700 border-teal-200';

    default:
      return 'bg-slate-50 text-slate-600 border-slate-200';
  }
}


// ============================================================
// API DONATION -> CARD FORMAT
// ============================================================

function normalizeDonation(item) {
  const categoryName =
    item.category_name ||
    item.category?.name ||
    item.category ||
    'Other';

  const categorySlug =
    item.category_slug ||
    item.category?.slug ||
    String(categoryName)
      .toLowerCase()
      .replace(/\s+/g, '-');

  let group = 'other';

  if (
    ['furniture', 'chairs', 'table', 'sofa'].some((x) =>
      categorySlug.toLowerCase().includes(x)
    )
  ) {
    group = 'furniture';
  } else if (
    ['clothes', 'apparel', 'shoes', 'jackets'].some((x) =>
      categorySlug.toLowerCase().includes(x)
    )
  ) {
    group = 'apparel';
  } else if (
    ['bags', 'accessories'].some((x) =>
      categorySlug.toLowerCase().includes(x)
    )
  ) {
    group = 'bags';
  } else if (
    ['kids', 'family', 'children'].some((x) =>
      categorySlug.toLowerCase().includes(x)
    )
  ) {
    group = 'kids';
  }

  const image =
    item.image ||
    item.thumbnail ||
    item.cover_image ||
    item.images?.[0]?.image ||
    item.images?.[0]?.url ||
    '/images/placeholder-donation.jpg';

  const condition = item.condition || 'Good';

  return {
    id: item.id,

    name:
      item.title ||
      item.name ||
      'Untitled Donation',

    category: categoryName,

    group,

    slug: categorySlug,

    image,

    description:
      item.description ||
      'Community donation item available for rehoming.',

    condition,

    conditionColor:
      getConditionColor(condition),

    location:
      item.location ||
      [item.city, item.state]
        .filter(Boolean)
        .join(', ') ||
      'Location not specified',

    availability:
      item.status === 'AVAILABLE' ||
      item.status === 'available'
        ? 'Available'
        : item.status || 'Available',

    views:
      item.views_count ||
      item.views ||
      0,

    createdAt:
      item.created_at ||
      item.createdAt ||
      null,

    isDemo: false,
  };
}


